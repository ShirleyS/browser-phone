# Browser Phone — environment variables. Copy to .env and fill in. Never commit real values.

# --- Backend database (Postgres via Supabase-compatible API) — required for Live mode ---
SUPABASE_URL=https://your-project.supabase.co
# Server-only service key. Used only inside /api/public/v1 handlers. Never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Limits (all optional; defaults shown) ---
BP_DAILY_SESSION_LIMIT=20            # new chat/call sessions per webhook per UTC day
BP_DAILY_PAIRING_LIMIT=10            # pairing-code sends per webhook per UTC day
BP_MAX_CONCURRENT_SESSIONS=3         # active sessions per webhook
BP_SESSION_TTL_SECONDS=1800          # session (and callback token) lifetime
BP_MAX_CALL_SECONDS=900              # max call duration
BP_CONNECTION_TOKEN_TTL_SECONDS=604800  # connection (phone) token lifetime, 7 days
BP_WEBHOOK_TIMEOUT_MS=8000
BP_MAX_BODY_BYTES=16384

# --- Networking (optional) ---
BP_DNS_RESOLVER_URL=https://cloudflare-dns.com/dns-query   # DNS-over-HTTPS JSON resolver for SSRF checks
BP_PUBLIC_BASE_URL=                  # override origin used in reply_url, e.g. https://phone.example.com
BP_ALLOW_INSECURE_WEBHOOKS=false     # Deprecated: delivery/registration always require public HTTPS

# Required for Live outbound delivery ONLY after independently enforced/tested public-only egress.
# Default unset = hosted delivery disabled. Node start:node installs pinned transport instead.
# This attestation does not install a firewall.
BP_PUBLIC_ONLY_EGRESS=
# Optional operator-controlled relay; an empty value explicitly disables it.
# RingOrden production defaults to its restricted relay, verified before use.
BP_PINNED_RELAY_ORIGIN=
# Node webhook example: exact HTTPS phone origin, no trailing slash
BP_PHONE_ORIGIN=
BP_SIGNING_SECRET=

# Optional Save my setup login. Leave all unset for a signup-free phone.
# Configure the MojoAuth hosted page for email magic links/OTP.
MOJOAUTH_ISSUER=
MOJOAUTH_CLIENT_ID=
MOJOAUTH_CLIENT_SECRET=
# Random 32-byte key encoded as 64 hex characters: openssl rand -hex 32
BP_ACCOUNT_ENCRYPTION_KEY=
# BP_PUBLIC_BASE_URL above must be the exact app origin (HTTPS outside localhost).
# Registered callback: <BP_PUBLIC_BASE_URL>/api/public/v1/account/callback
